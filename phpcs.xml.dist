<?xml version="1.0"?>
<ruleset name="Toplist Block Ruleset">
	<description>WordPress Coding Standards for Toplist Block</description>

	<!-- Pass some flags to PHPCS:
		 p flag: Show progress of the run.
		 s flag: Show sniff codes in all reports.
	-->
	<arg value="ps"/>

	<!-- Strip the filepaths down to the relevant bit. -->
	<arg name="basepath" value="./"/>

	<!-- Check up to 8 files simultaneously. -->
	<arg name="parallel" value="8"/>

	<!-- Only check PHP files. -->
	<arg name="extensions" value="php"/>

	<!-- Directories to check. -->
	<file>toplist-block/</file>

	<!-- Exclude paths. -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/toplist-block-lite/*</exclude-pattern>

	<!-- Include the WordPress ruleset. -->
	<rule ref="WordPress">
		<!-- We may want to lower the strictness or exclude specific sniffs for a legacy codebase -->
		<!-- For example, if we have long files or missing docs, we can exclude them temporarily -->
	</rule>

	<!-- Verify that the text_domain is set to the desired text-domain. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="toplist"/>
			</property>
		</properties>
	</rule>

	<!-- Set minimum supported WP version. -->
	<config name="minimum_supported_wp_version" value="6.0"/>
</ruleset>
