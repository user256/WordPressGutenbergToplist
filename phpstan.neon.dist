includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 9

    paths:
        - toplist-block/toplist-block.php
        - toplist-block/settings-page.php
        - toplist-block/includes

    bootstrapFiles:
        - tests/phpstan-bootstrap.php

    # Legacy procedural plugin now checked directly at level 9 without baselines.
    reportUnmatchedIgnoredErrors: false
