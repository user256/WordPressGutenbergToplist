{
    "name": "user256/toplist-block",
    "description": "Developer tooling and tests for Toplist Block WordPress plugin.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^1.11",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "wp-coding-standards/wpcs": "^3.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2"
    },
    "scripts": {
        "phpstan": "phpstan analyse -c phpstan.neon.dist",
        "phpcs": "phpcs",
        "test": "phpunit -c phpunit.xml.dist --testsuite unit",
        "test:build": "php tests/build/run.php",
        "test:integration": "phpunit -c phpunit.xml.dist --testsuite integration",
        "check": [
            "@test",
            "@phpcs",
            "@phpstan",
            "@test:build"
        ],
        "build": "php scripts/build-lite.php"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
