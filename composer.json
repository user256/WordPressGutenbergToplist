{
    "name": "user256/toplist-block",
    "description": "Developer tooling and tests for Toplist Block WordPress plugin.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist --testsuite unit",
        "test:build": "php tests/build/run.php",
        "test:integration": "phpunit -c phpunit.xml.dist --testsuite integration",
        "build": "php scripts/build-lite.php"
    }
}
